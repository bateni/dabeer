%D Load definitions for Amin Abedi's fonts
\loadtypescriptfile[aminabedi]  %% for Estedad, Mikhak and Azarmehr Monospace
\loadtypescriptfile[mathfonts]  %% for Math fonts
%D Finally we define our font family.
\starttypescript  [dabeerfun]
  \definetypeface [dabeerfun][rm] [serif][estedad]                    [default]
  \definetypeface [dabeerfun][ss] [sans] [mikhak]                     [default]
  \definetypeface [dabeerfun][tt] [mono] [azarmehr]                   [default]
  \definetypeface [dabeerfun][mm] [math] [fall:estedad,main:concrete] [default]
%  \definetypeface [dabeerfun][mm] [math] [fall:mikhak,main:penn]      [default]
\stoptypescript
